# =========================================================
# SERVER
# =========================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# =========================================================
# DATABASE (Neon PostgreSQL)
# =========================================================
# Get this from your Neon project dashboard -> Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/sales_intelligence?sslmode=require"

# =========================================================
# AUTH
# =========================================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# =========================================================
# GEMINI / LANGCHAIN (Conversation Brain, Customer DNA reasoning)
# =========================================================
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# =========================================================
# DEEPGRAM (Speech to Text) — legacy pipeline, being retired in favor of Vapi
# =========================================================
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================
# ELEVENLABS (Text to Speech) — legacy pipeline, being retired in favor of Vapi
# =========================================================
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# =========================================================
# VAPI (Voice call orchestration — Elliot v2 voice + Soniox STT)
# =========================================================
# Private/server key — from Vapi dashboard, used for backend REST calls only.
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key for the browser Web SDK (@vapi-ai/web) — a DIFFERENT key than
# VAPI_API_KEY above. Never use the private key client-side.
VAPI_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_ASSISTANT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then push the same value to the Assistant's server.secret via the vapi.js config helper.
VAPI_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================
# WEBRTC / REALTIME
# =========================================================
TURN_SERVER_URL=turn:your-turn-server:3478
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# =========================================================
# RATE LIMITING
# =========================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Dev-only override for the auth (/login, /register) rate limit. Ignored in
# production, which always enforces a hardcoded strict limit of 10 per
# 15 minutes regardless of this value (see src/middleware/rateLimiter.js).
AUTH_RATE_LIMIT_MAX_DEV=100

# =========================================================
# CORS
# =========================================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
